TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgres://causality:causality@localhost:5433/causality
# any OpenAI-compatible chat endpoint; leave unset to run Defy fate on templates only
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=router
# per-role overrides (LLM_REFEREE_*, LLM_NARRATOR_*, LLM_CHRONICLER_*) fall back to the shared LLM_* values
LLM_REFEREE_MODEL=mistral
# a claude- model (or LLM_<ROLE>_PROVIDER=anthropic) uses the Anthropic SDK with ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
LLM_NARRATOR_MODEL=claude-haiku-4-5
LLM_CHRONICLER_MODEL=claude-opus-5
# set to 0 for endpoints that reject unknown fields (only Venice-backed ones need the flag)
LLM_VENICE_PARAMS=1
