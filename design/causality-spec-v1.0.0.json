{
  "game": {
    "title": "Causality",
    "version": "1.0.0",
    "description": "A hardcore mobile tower-climbing game where exceptional player actions create permanent, stacking world changes that affect all future players",
    "platforms": ["iOS", "Android", "WebGL"],
    "game_modes": ["text_based_mud", "2d_hack_slash"],
    "core_philosophy": [
      "player_actions_shape_world_permanently",
      "emergent_gameplay",
      "meaningful_permadeath",
      "economic_scarcity",
      "player_agency",
      "long_term_investment",
      "cascading_consequences"
    ]
  },

  "character_system": {
    "stats": {
      "primary_attributes": {
        "might": {
          "description": "Physical strength and melee damage",
          "affects": ["melee_damage", "carry_capacity", "intimidation"],
          "aging_impact": "high_physical_decline"
        },
        "agility": {
          "description": "Speed, reflexes, and dexterity",
          "affects": ["dodge", "attack_speed", "initiative"],
          "aging_impact": "high_physical_decline"
        },
        "grit": {
          "description": "Endurance and resilience",
          "affects": ["hp", "stamina", "resistance"],
          "aging_impact": "moderate_physical_decline"
        },
        "cunning": {
          "description": "Cleverness and tactical thinking",
          "affects": ["crit_chance", "trap_detection", "strategy"],
          "aging_impact": "improves_with_age"
        },
        "focus": {
          "description": "Mental discipline and concentration",
          "affects": ["magic_power", "crafting_quality", "skill_retention"],
          "aging_impact": "stable"
        },
        "perception": {
          "description": "Awareness and observation",
          "affects": ["detection", "accuracy", "resource_finding"],
          "aging_impact": "slight_decline"
        },
        "guile": {
          "description": "Deception and subterfuge",
          "affects": ["stealth", "persuasion", "market_margins"],
          "aging_impact": "improves_with_age"
        },
        "presence": {
          "description": "Leadership and charisma",
          "affects": ["faction_influence", "npc_reactions", "trade_prices"],
          "aging_impact": "improves_with_age"
        }
      },

      "derived_stats": {
        "hp": "base_100 + (grit * 15) + (might * 5)",
        "stamina": "base_50 + (grit * 10) + (agility * 5)",
        "initiative": "(agility * 2) + perception",
        "carry_capacity": "base_20 + (might * 3)",
        "dodge": "(agility * 2) + (perception)",
        "block": "(might * 2) + (grit)",
        "magic_resistance": "(focus * 2) + (grit)",
        "social_standing": "(presence * 2) + (guile)",
        "crafting_skill": "(focus * 2) + (cunning)",
        "trade_skill": "(guile * 2) + (presence)"
      },

      "stat_growth": {
        "points_per_level": 3,
        "max_level": 100,
        "soft_cap_per_stat": 100,
        "hard_cap_per_stat": 150
      }
    },

    "aging_system": {
      "real_time_conversion": "3_months_real_equals_full_lifetime",
      "lifespan": {
        "min_playable_age": 15,
        "peak_physical_age": 30,
        "peak_overall_age": 45,
        "average_death_age": 75,
        "max_age": 90
      },
      "age_phases": {
        "youth": {
          "age_range": [15, 25],
          "modifiers": {
            "might": 0.9,
            "agility": 1.1,
            "grit": 0.95,
            "cunning": 0.85,
            "focus": 0.9,
            "perception": 1.0,
            "guile": 0.8,
            "presence": 0.85
          },
          "growth_rate": 1.5
        },
        "young_adult": {
          "age_range": [26, 35],
          "modifiers": {
            "all_stats": 1.0
          },
          "growth_rate": 1.2
        },
        "prime": {
          "age_range": [36, 45],
          "modifiers": {
            "might": 1.0,
            "agility": 0.98,
            "cunning": 1.1,
            "focus": 1.1,
            "guile": 1.15,
            "presence": 1.15
          },
          "growth_rate": 1.0
        },
        "middle_age": {
          "age_range": [46, 60],
          "modifiers": {
            "might": 0.95,
            "agility": 0.92,
            "grit": 0.97,
            "cunning": 1.15,
            "focus": 1.1,
            "perception": 0.98,
            "guile": 1.2,
            "presence": 1.2
          },
          "growth_rate": 0.8
        },
        "elder": {
          "age_range": [61, 90],
          "modifiers": {
            "might": "0.9 - (age-60)*0.01",
            "agility": "0.85 - (age-60)*0.015",
            "grit": "0.92 - (age-60)*0.008",
            "cunning": 1.2,
            "focus": 1.05,
            "perception": "0.95 - (age-60)*0.005",
            "guile": 1.25,
            "presence": 1.25
          },
          "growth_rate": 0.5
        }
      }
    },

    "emergent_class_system": {
      "class_discovery": {
        "mechanism": "achievement_based",
        "requirements_hidden": true,
        "multi_classing_allowed": true
      },
      "example_classes": {
        "blade_master": {
          "requirements": {
            "might": 50,
            "agility": 40,
            "melee_kills": 500,
            "perfect_parries": 100
          },
          "bonuses": {
            "melee_damage": 1.25,
            "parry_window": 1.5,
            "dual_wield_unlock": true
          }
        },
        "shadow_walker": {
          "requirements": {
            "agility": 60,
            "guile": 50,
            "stealth_missions": 100,
            "undetected_floor_clears": 20
          },
          "bonuses": {
            "stealth_effectiveness": 1.5,
            "backstab_damage": 2.0,
            "shadow_step_ability": true
          }
        },
        "merchant_prince": {
          "requirements": {
            "presence": 70,
            "guile": 60,
            "total_trades": 1000,
            "profit_earned": 100000
          },
          "bonuses": {
            "trade_margins": 1.3,
            "market_influence": 1.5,
            "exclusive_contracts": true
          }
        },
        "artificer": {
          "requirements": {
            "focus": 60,
            "cunning": 50,
            "items_crafted": 500,
            "legendary_crafts": 10
          },
          "bonuses": {
            "crafting_quality": 1.4,
            "resource_efficiency": 1.25,
            "unique_recipes": true
          }
        }
      }
    },

    "skill_progression": {
      "action_based_learning": true,
      "skills": {
        "combat_skills": {
          "melee": {
            "gained_from": ["melee_attacks", "melee_kills", "parries"],
            "unlocks": ["combo_attacks", "weapon_mastery", "counter_strikes"]
          },
          "ranged": {
            "gained_from": ["ranged_attacks", "headshots", "long_range_kills"],
            "unlocks": ["quick_draw", "piercing_shots", "ricochet"]
          },
          "magic": {
            "gained_from": ["spell_casts", "mana_spent", "spell_combinations"],
            "unlocks": ["spell_power", "mana_efficiency", "dual_casting"]
          }
        },
        "crafting_skills": {
          "smithing": {
            "gained_from": ["items_forged", "materials_refined", "repairs"],
            "unlocks": ["quality_tiers", "special_alloys", "enchantment_slots"]
          },
          "alchemy": {
            "gained_from": ["potions_brewed", "ingredients_discovered", "experiments"],
            "unlocks": ["potion_strength", "duration", "combination_effects"]
          }
        },
        "social_skills": {
          "leadership": {
            "gained_from": ["faction_management", "successful_delegations", "followers_gained"],
            "unlocks": ["larger_groups", "loyalty_bonuses", "inspiration_auras"]
          },
          "negotiation": {
            "gained_from": ["successful_trades", "diplomatic_solutions", "price_haggling"],
            "unlocks": ["better_prices", "exclusive_deals", "faction_mediation"]
          }
        }
      }
    },

    "death_system": {
      "permadeath": true,
      "death_triggers": [
        "hp_reaches_zero",
        "failed_death_save",
        "execution_by_floor_lord",
        "environmental_hazard",
        "old_age",
        "disease",
        "assassination"
      ],
      "death_prevention": {
        "extremely_rare": true,
        "methods": {
          "phoenix_feather": {
            "rarity": "mythic",
            "uses": 1,
            "effect": "resurrect_on_death"
          },
          "divine_intervention": {
            "requirement": "max_religion_standing",
            "chance": 0.01,
            "cooldown_days": 30
          },
          "guild_rescue": {
            "requirement": "guild_emergency_protocol",
            "cost": "50000_currency",
            "member_vote_required": true
          }
        }
      },
      "legacy_system": {
        "inheritance": {
          "currency": 0.1,
          "items": "one_chosen_item",
          "reputation": 0.25,
          "knowledge": "discovered_recipes_and_locations"
        },
        "memorial": {
          "hall_of_heroes": true,
          "epitaph_system": true,
          "achievement_preservation": true
        }
      }
    }
  },

